# ==============================================================================
# E-Request Admin Portal - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local (or .env.development.local) to configure local development.
# IMPORTANT: .env.local is ignored by Git and will NEVER be committed.
#
# Default behavior (when VITE_USE_FIREBASE_EMULATORS is false or unset):
# Connects to production Firebase (project: e-resquest).
# ==============================================================================

# Enable local Firebase Emulators (Auth & Firestore)
# Values: "true" | "false" (Default: "false")
VITE_USE_FIREBASE_EMULATORS=false

# Isolated Demo Firebase Project ID
# SAFETY REQUIREMENT: In emulator mode, this MUST start with "demo-"
# (e.g. "demo-erequest-portal"). The application will FAIL FAST and refuse
# to initialize if set to a non-demo project ID.
VITE_FIREBASE_EMULATOR_PROJECT_ID=demo-erequest-portal

# Emulator Host & Ports (Must match your local firebase.json emulator settings)
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8088
# ==============================================================================
# EmailJS Configuration (Forgot Password & OTP Delivery)
# ==============================================================================
VITE_EMAILJS_SERVICE_ID=service_4rwr6df
VITE_EMAILJS_TEMPLATE_ID=template_065t767
# EmailJS Public Key from https://dashboard.emailjs.com/admin/account
VITE_EMAILJS_PUBLIC_KEY=iC0ESDFLUm8ZrV8q2

# ==============================================================================
# Cloudinary Configuration (Procedure Step Image Uploads)
# ==============================================================================
VITE_CLOUDINARY_CLOUD_NAME=hu9xgqne
VITE_CLOUDINARY_UPLOAD_PRESET=erequest_procedure_images
